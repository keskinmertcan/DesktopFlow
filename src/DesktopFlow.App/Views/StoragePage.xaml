<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopFlow.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DesktopFlow.App.ViewModels"
    x:DefaultBindMode="OneWay">
    <Grid Padding="28,20,28,28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Storage_PageTitle], Source={StaticResource Loc}}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Storage_Subtitle], Source={StaticResource Loc}}" />
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasError}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage}" IsClosable="False" />
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding [Storage_Scan], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.CanRun}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="{Binding [Storage_Cancel], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy}" Width="20" Height="20" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status}" TextWrapping="WrapWholeWords" />
            <TextBlock Text="{x:Bind ViewModel.CurrentPath}" Foreground="{ThemeResource AppMutedBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Pivot Grid.Row="3">
            <PivotItem Header="{Binding [Storage_TabDrives], Source={StaticResource Loc}}">
                <ListView ItemsSource="{x:Bind ViewModel.Drives}" SelectionMode="None" Padding="0,12,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriveRow">
                            <StackPanel Spacing="6" Padding="0,8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind UsedPercent}" Height="8" />
                                <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource AppMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="{Binding [Storage_TabFolders], Source={StaticResource Loc}}">
                <Grid Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Storage_ScanPrompt], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.ShowScanPrompt, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding [Storage_NoFolders], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.ShowNoFolders, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Folders}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderRow">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Path}" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Size}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind Files}" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Center" Content="{Binding [Storage_Open], Source={StaticResource Loc}}" Command="{x:Bind OpenCommand}" CommandParameter="{x:Bind Path}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="{Binding [Storage_TabTypes], Source={StaticResource Loc}}">
                <Grid Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Storage_ScanPrompt], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.ShowScanPrompt, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding [Storage_NoTypes], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.ShowNoCategories, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryRow">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind Share}" Height="8" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind Size}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind Files}" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="{Binding [Storage_TabDuplicates], Source={StaticResource Loc}}">
                <Grid Padding="0,12,0,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Storage_ScanPrompt], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.ShowScanPrompt, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding [Storage_NoDuplicates], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.ShowNoDuplicates, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind ViewModel.MoreDuplicates}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Duplicates}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DuplicateRow">
                                <StackPanel Spacing="6" Padding="0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Size}" Foreground="{ThemeResource AppMutedBrush}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind Paths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PathRow">
                                                <Grid ColumnSpacing="8" Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Content="{Binding [Storage_Show], Source={StaticResource Loc}}" Command="{x:Bind OpenCommand}" CommandParameter="{x:Bind Path}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
