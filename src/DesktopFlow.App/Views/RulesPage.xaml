<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RulePage"
    x:Class="DesktopFlow.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DesktopFlow.App.ViewModels"
    x:DefaultBindMode="OneWay">
    <ScrollViewer Padding="28,20,28,28">
        <StackPanel Spacing="16" MaxWidth="980">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Rules_Title], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Rules_Subtitle], Source={StaticResource Loc}}" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage}" IsClosable="False" />
            <Button Content="{Binding [Rules_Add], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.AddCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding [Rules_Empty], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" Visibility="{x:Bind ViewModel.HasRules, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuleRowViewModel">
                        <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="WrapWholeWords" />
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" Toggled="{x:Bind OnToggled}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="{Binding [Rules_Up], Source={StaticResource Loc}}" Command="{Binding ViewModel.MoveUpCommand, ElementName=RulePage}" CommandParameter="{x:Bind}" />
                                    <Button Content="{Binding [Rules_Down], Source={StaticResource Loc}}" Command="{Binding ViewModel.MoveDownCommand, ElementName=RulePage}" CommandParameter="{x:Bind}" />
                                    <Button Content="{Binding [Rules_Edit], Source={StaticResource Loc}}" Command="{Binding ViewModel.EditCommand, ElementName=RulePage}" CommandParameter="{x:Bind}" />
                                    <Button Content="{Binding [Rules_Delete], Source={StaticResource Loc}}" Command="{Binding ViewModel.DeleteCommand, ElementName=RulePage}" CommandParameter="{x:Bind}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Rules_Conflicts], Source={StaticResource Loc}}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Conflicts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
