<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopFlow.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneWay">
    <ScrollViewer Padding="40,32">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind ViewModel.StepLabel}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage}" IsClosable="False" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsWelcome, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Setup_WelcomeTitle], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Setup_WelcomeBody], Source={StaticResource Loc}}" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFolders, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Setup_FoldersTitle], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Setup_FoldersBody], Source={StaticResource Loc}}" />
                <ToggleSwitch Header="{Binding [Setup_WatchDesktop], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.WatchDesktop, Mode=TwoWay}" />
                <TextBlock Text="{Binding [Settings_DesktopPath], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.DesktopPath, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="{Binding [Settings_Browse], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.BrowseDesktopCommand}" />
                </Grid>
                <ToggleSwitch Header="{Binding [Setup_WatchDownloads], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.WatchDownloads, Mode=TwoWay}" />
                <TextBlock Text="{Binding [Settings_DownloadsPath], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.DownloadsPath, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="{Binding [Settings_Browse], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.BrowseDownloadsCommand}" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsPreferences, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Setup_PrefsTitle], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Setup_PrefsBody], Source={StaticResource Loc}}" />
                <ToggleSwitch Header="{Binding [Settings_Shortcuts], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.KeepShortcuts, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsBehavior, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Setup_BehaviorTitle], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Setup_BehaviorBody], Source={StaticResource Loc}}" />
                <ToggleSwitch Header="{Binding [Settings_Automatic], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.Automatic, Mode=TwoWay}" />
                <ToggleSwitch Header="{Binding [Settings_Notifications], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.Notifications, Mode=TwoWay}" />
                <ToggleSwitch Header="{Binding [Settings_Startup], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                <ToggleSwitch Header="{Binding [Settings_Minimized], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                <TextBlock Text="{Binding [Settings_Delay], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" />
                <NumberBox Value="{x:Bind ViewModel.Delay, Mode=TwoWay}" Minimum="500" Maximum="60000" SmallChange="100" SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Setup_PreviewTitle], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.PreviewText}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFinish, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Setup_DoneTitle], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Setup_DoneBody], Source={StaticResource Loc}}" />
                <ToggleSwitch Header="{Binding [Setup_OrganizeNow], Source={StaticResource Loc}}" IsOn="{x:Bind ViewModel.OrganizeNow, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding [Setup_Back], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.BackCommand}" IsEnabled="{x:Bind ViewModel.CanGoBack}" />
                <Button Content="{x:Bind ViewModel.ForwardText}" Command="{x:Bind ViewModel.ForwardCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
