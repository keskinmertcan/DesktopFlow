<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopFlow.App.Views.FolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DesktopFlow.App.ViewModels"
    x:DefaultBindMode="OneWay">
    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>
    <Grid Padding="28,20,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Subtitle}" />
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasError}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage}" IsClosable="False" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ToggleSwitch x:Name="MonitorSwitch" IsOn="{x:Bind ViewModel.Monitoring, Mode=TwoWay}" Toggled="MonitorSwitch_Toggled" />
            <TextBlock VerticalAlignment="Center" Text="{Binding [Folder_Monitoring], Source={StaticResource Loc}}" />
            <Button Content="{Binding [Folder_Refresh], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="{Binding [Folder_Organize], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.OrganizeAllCommand}" IsEnabled="{x:Bind ViewModel.CanRun}" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="{Binding [Folder_OrganizeSelected], Source={StaticResource Loc}}" Command="{x:Bind ViewModel.OrganizeSelectedCommand}" IsEnabled="{x:Bind ViewModel.CanRun}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy}" Width="20" Height="20" />
        </StackPanel>
        <Grid Grid.Row="3">
            <TextBlock Text="{Binding [Empty_Files], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" Visibility="{x:Bind ViewModel.HasFiles, Converter={StaticResource InverseBoolToVisibility}}" />
            <ListView x:Name="FileList" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Multiple" SelectionChanged="FileList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileRowViewModel">
                        <Grid ColumnSpacing="16" Padding="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Size}" Foreground="{ThemeResource AppMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Destination}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Status}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
