<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DesktopFlow.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneWay">
    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>
    <ScrollViewer Padding="28,20,28,28">
        <StackPanel Spacing="20" MaxWidth="1100">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [Overview_Title], Source={StaticResource Loc}}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [Overview_Subtitle], Source={StaticResource Loc}}" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage}" IsClosable="False" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding [Metric_Organized], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind ViewModel.Organized}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding [Metric_Pending], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind ViewModel.Pending}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding [Metric_Rules], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind ViewModel.ActiveRules}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding [Metric_Files], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind ViewModel.DesktopFiles}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Quick_Title], Source={StaticResource Loc}}" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button MinHeight="44" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanRun}" Command="{x:Bind ViewModel.OrganizeDesktopCommand}">
                            <TextBlock Text="{Binding [Quick_OrganizeDesktop], Source={StaticResource Loc}}" TextWrapping="WrapWholeWords" TextAlignment="Center" />
                        </Button>
                        <Button Grid.Column="1" MinHeight="44" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanRun}" Command="{x:Bind ViewModel.OrganizeDownloadsCommand}">
                            <TextBlock Text="{Binding [Quick_OrganizeDownloads], Source={StaticResource Loc}}" TextWrapping="WrapWholeWords" TextAlignment="Center" />
                        </Button>
                        <Button Grid.Row="1" MinHeight="44" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.TogglePauseCommand}">
                            <TextBlock Text="{x:Bind ViewModel.PauseText}" TextWrapping="WrapWholeWords" TextAlignment="Center" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" MinHeight="44" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.OpenDesktopCommand}">
                            <TextBlock Text="{Binding [Quick_OpenDesktop], Source={StaticResource Loc}}" TextWrapping="WrapWholeWords" TextAlignment="Center" />
                        </Button>
                    </Grid>
                    <TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="{x:Bind ViewModel.LastRun}" TextWrapping="WrapWholeWords" />
                    <TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="{x:Bind ViewModel.MonitorLine}" TextWrapping="WrapWholeWords" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Recent_Title], Source={StaticResource Loc}}" />
                        <TextBlock Text="{Binding [Empty_Recent], Source={StaticResource Loc}}" Visibility="{x:Bind ViewModel.HasRecent, Converter={StaticResource InverseBoolToVisibility}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [Storage_Title], Source={StaticResource Loc}}" />
                        <TextBlock Text="{Binding [Overview_Monitor], Source={StaticResource Loc}}" Foreground="{ThemeResource AppMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MonitorLine}" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding [Empty_Storage], Source={StaticResource Loc}}" Visibility="{x:Bind ViewModel.HasStorage, Converter={StaticResource InverseBoolToVisibility}}" Foreground="{ThemeResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Storage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,4" TextWrapping="WrapWholeWords" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
