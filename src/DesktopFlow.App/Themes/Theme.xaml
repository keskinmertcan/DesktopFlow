<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DesktopFlow.App.Converters">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#17191E</Color>
            <Color x:Key="AppSurfaceColor">#20232A</Color>
            <Color x:Key="AppTextColor">#F4F5F7</Color>
            <Color x:Key="AppMutedColor">#A0A5B0</Color>
            <Color x:Key="AppAccentColor">#3987F5</Color>
            <Color x:Key="AppSuccessColor">#35B779</Color>
            <Color x:Key="AppWarningColor">#E5A43B</Color>
            <Color x:Key="AppErrorColor">#E05252</Color>
            <Color x:Key="AppStrokeColor">#343844</Color>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource AppMutedColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="{StaticResource AppErrorColor}" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="{StaticResource AppStrokeColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F4F5F7</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppTextColor">#17191E</Color>
            <Color x:Key="AppMutedColor">#5C6370</Color>
            <Color x:Key="AppAccentColor">#3987F5</Color>
            <Color x:Key="AppSuccessColor">#1E8C57</Color>
            <Color x:Key="AppWarningColor">#A8741C</Color>
            <Color x:Key="AppErrorColor">#C43B3B</Color>
            <Color x:Key="AppStrokeColor">#D9DDE6</Color>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource AppMutedColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="{StaticResource AppErrorColor}" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="{StaticResource AppStrokeColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#000000" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#FFFF00" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#00FF00" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#FFFF00" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#FF0000" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="SurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
</ResourceDictionary>
